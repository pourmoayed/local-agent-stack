# Copy this file to .env and fill in the values. Never commit .env.

# --- GENERAL ---
SYSTEM_TIMEZONE=Europe/Berlin

# --- POSTGRES (Supabase image, also used by n8n) ---
SUPABASE_DB_PASSWORD=change-me

# --- OPEN WEBUI ---
# Random string used to sign auth tokens.
# PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# Bash:       openssl rand -hex 32
WEBUI_JWT_SECRET=change-me

# --- SEARXNG ---
# Same generation commands as above.
SEARXNG_SECRET=change-me

# --- OLLAMA CLOUD (optional) ---
OLLAMA_CLOUD_API_KEY=
